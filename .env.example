# Google Gemini API key (required)
GOOGLE_API_KEY=your_gemini_api_key_here

# Reasoning provider ("gemini" is the only bundled provider)
LLM_PROVIDER=gemini

# Model override
# MODEL_NAME=gemini-2.5-flash

# Sandbox directory the agent is allowed to read and write
PROJECT_ROOT=./sandbox/example_project

# Per-execution timeout in seconds for scripts launched by the agent
EXEC_TIMEOUT=30

# LLM retry policy for transient failures (rate limits, 5xx)
LLM_MAX_RETRIES=3
LLM_RETRY_BASE_DELAY=1.0

# Directory for repair report artifacts
REPORTS_DIR=reports
